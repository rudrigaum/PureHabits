build/
DerivedData/
xcuserdata/
*.xcuserstate
*.pbxuser
!default.pbxuser
*.xccheckout
*.moved-aside
*.hmap
*.ipa

# Debug Symbols (Crucial for repository size optimization)
*.dSYM.zip
*.dSYM

# OS X files
.DS_Store
.AppleDouble
.LSOverride

# ##########################
# Swift Package Manager (SPM)
# ##########################
.build/
Packages/
.swiftpm/xcode/package.xcworkspace/xcuserdata/
.swiftpm/xcode/project.xcworkspace/xcuserdata/

# ##########################
# CocoaPods
# ##########################
Pods/
Podfile.lock

# ##########################
# Fastlane & Automation
