# Set default behavior to automatically normalize line endings
* text=auto

# Force LF (Unix) line endings for all text-based source files
# This prevents Windows/Unix line-ending mismatches (CRLF vs LF)
*.swift text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.xcconfig text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

# Denote all files that are truly binary and should not be modified by Git's line ending normalization
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.appiconset/** binary
*.imageset/** binary
